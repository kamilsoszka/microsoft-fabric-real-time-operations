      },
      "text": "operations_events\r\n| summarize avg_temperature_c = round(avg(temperature_c), 1) by facility_id\r\n| order by avg_temperature_c desc",
      "id": "740ad2f6-e067-4cf3-be43-8dfe85a7eb6d",
