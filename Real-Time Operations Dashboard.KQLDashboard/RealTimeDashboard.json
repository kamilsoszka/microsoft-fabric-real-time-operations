      },
      "text": "operations_events\r\n| summarize\r\n    avg_temperature_c = round(avg(temperature_c), 1),\r\n    avg_vibration_mm_s = round(avg(vibration_mm_s), 1),\r\n    max_temperature_c = max(temperature_c),\r\n    max_vibration_mm_s = max(vibration_mm_s)\r\n    by equipment_id\r\n| order by max_temperature_c desc",
      "id": "1587cb04-0878-4442-8dd0-edaa4206775e",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "33ff5bcd-f165-4f5f-8887-05e292b08b9c"
      },
      "text": "operations_events\r\n| where status == \"Critical\"\r\n    or temperature_c >= 85.0\r\n    or vibration_mm_s >= 8.0\r\n| summarize critical_event_count = count()",
      "id": "19c54d95-a55b-46bf-9aa6-3b80614d1b4e",
      "usedVariables": []
    },
    {
