// Critical Events KPI
operations_events
| where status == "Critical"
    or temperature_c >= 85.0
    or vibration_mm_s >= 8.0
| summarize critical_event_count = count()

// Maximum Temperature by Equipment
operations_events
| summarize
    avg_temperature_c = round(avg(temperature_c), 1),
    avg_vibration_mm_s = round(avg(vibration_mm_s), 1),
    max_temperature_c = max(temperature_c),
    max_vibration_mm_s = max(vibration_mm_s)
    by equipment_id
| order by max_temperature_c desc

// Average Temperature by Facility
operations_events
| summarize avg_temperature_c = round(avg(temperature_c), 1) by facility_id
| order by avg_temperature_c desc

// Average Temperature Over Time
operations_events
| summarize avg_temperature_c = round(avg(temperature_c), 1) by event_time
| order by event_time asc
